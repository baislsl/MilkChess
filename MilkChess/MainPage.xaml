<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:userInterface="clr-namespace:MilkChess.UserInterface"
             x:DataType="userInterface:ChessBoardViewModel"
             x:Class="MilkChess.MainPage">

    <HorizontalStackLayout
        Margin="20">
        <AbsoluteLayout
            WidthRequest="{Binding ChessBoardWidth}"
            HeightRequest="{Binding ChessBoardHeight}"
            x:Name="ChessBoardLayout">
        </AbsoluteLayout>

        <StackLayout
            Margin="10">
            <Grid
                Margin="4"
                WidthRequest="300"
                HeightRequest="120"
                x:Name="CommonFunction">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Reset" Clicked="ResetCommand" />
                <Button Grid.Row="0" Grid.Column="2" Text="ToBegin" Clicked="MoveToStartCommand" />
                <Button Grid.Row="0" Grid.Column="3" Text="ToEnd" Clicked="MoveToEndCommand" />

                <Button Grid.Row="1" Grid.Column="0" Text="Go back" Clicked="MoveBackwardCommand" />
                <Button Grid.Row="1" Grid.Column="1" Text="Go back1" Clicked="MoveBackwardCommand" />
                <Button Grid.Row="1" Grid.Column="2" Text="Move forward1" Clicked="MoveForwardCommand" />
                <Button Grid.Row="1" Grid.Column="3" Text="Move forward" Clicked="MoveForwardCommand" />


            </Grid>
        </StackLayout>
    </HorizontalStackLayout>
</ContentPage>