<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:userInterface="clr-namespace:MilkChess.UserInterface"
             x:DataType="userInterface:ChessBoardViewModel"
             x:Name="ChessBoardPage"
             x:Class="MilkChess.MainPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding ChessBoardHeight}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <HorizontalStackLayout Grid.Row="0">
            <AbsoluteLayout
                WidthRequest="{Binding ChessBoardWidth}"
                HeightRequest="{Binding ChessBoardHeight}"
                x:Name="ChessBoardLayout">
            </AbsoluteLayout>
            <Grid
                Margin="5"
                x:Name="CommonFunction">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Reset"
                        Command="{Binding ResetCommand}" />

                <Button Grid.Row="1" Grid.Column="0" Text="Go back" Command="{Binding MoveBackwardCommand}" />
                <Button Grid.Row="1" Grid.Column="1" Text="Move forward" Command="{Binding MoveForwardCommand}" />

                <Button Grid.Row="2" Grid.Column="0" Text="To Start" Command="{Binding MoveToStartCommand}" />
                <Button Grid.Row="2" Grid.Column="1" Text="To End" Command="{Binding  MoveToEndCommand}" />

                <Button Grid.Row="3" Grid.Column="0" Text="{Binding ConnectOrDisconnectEngineText}"
                        Command="{Binding ConnectOrDisconnectEngineCommand}" />

                <Button Grid.Row="3" Grid.Column="1"
                        BackgroundColor="{Binding SwitchToStopModeColor}"
                        Text="Stop"
                        Command="{Binding StopEngineCommand }" />
                <Button Grid.Row="4" Grid.Column="0"
                        BackgroundColor="{Binding SwitchToAnalyzeModeColor}"
                        Text="AnalyzeMode"
                        Command="{Binding SwitchToAnalyzeModeCommand }" />
                <Button Grid.Row="4" Grid.Column="1"
                        BackgroundColor="{Binding SwitchToAutoModeColor}"
                        Text="AutoMode"
                        Command="{Binding SwitchToAutoModeCommand }" />
                <Button Grid.Row="5" Grid.Column="0"
                        BackgroundColor="{Binding SwitchToRedAutoModeColor}"
                        Text="RedAutoMode"
                        Command="{Binding SwitchToRedAutoModeCommand}" />
                <Button Grid.Row="5" Grid.Column="1"
                        BackgroundColor="{Binding SwitchToBlackAutoModeColor}"
                        Text="BlackAutoMode"
                        Command="{Binding SwitchToBlackAutoModeCommand}" />

                <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Text="UseBestMovement"
                        Command="{Binding InvokeBestMovementCommand}" />

                <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Text="RotateBoard"
                        Command="{Binding ReverseBoardCommand}" />

                <Button Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Text="SaveLayout"
                        Command="{Binding SaveChessManualCommand}" />
            </Grid>
            <VerticalStackLayout
                WidthRequest="300">
                <Label Text="History Movements:"
                       FontAttributes="Bold"
                       Margin="2"
                       FontSize="18" />
                <ListView
                    x:Name="MovementView"
                    RowHeight="20"
                    MinimumHeightRequest="{Binding ChessBoardHeight}"
                    BackgroundColor="LightBlue"
                    xmlns:local="clr-namespace:MilkChess.Model"
                    ItemsSource="{Binding HistoryMovements}">
                    <ListView.Resources>
                        <local:MovementColorConvertor x:Key="MovementColorConvertor" />
                    </ListView.Resources>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Button
                                    Command="{Binding Source={x:Reference ChessBoardPage}, Path=ChessBoardViewModel.SwitchToSelectedMovementCommand}"
                                    CommandParameter="{Binding}"
                                    VerticalOptions="Fill"
                                    HorizontalOptions="Start"
                                    BorderWidth="0"
                                    CornerRadius="1"
                                    Margin="1"
                                    BackgroundColor="LightGray"
                                    FontSize="18"
                                    FontAttributes="Bold">
                                    <Button.TextColor>
                                        <Color>Black</Color>
                                        <!-- <MultiBinding Converter="{StaticResource MovementColorConvertor}"> -->
                                        <!--     <Binding  /> -->
                                        <!--     <Binding Source="{x:Reference ChessBoardPage}" -->
                                        <!--              Path="CurrentHistoryManagerCursor" /> -->
                                        <!-- </MultiBinding> -->
                                    </Button.TextColor>
                                    <Button.Text>
                                        <MultiBinding StringFormat="{}{0}. {1}">
                                            <Binding Path="ActionCount" />
                                            <Binding Path="ChineseViewableString" />
                                        </MultiBinding>
                                    </Button.Text>
                                </Button>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </VerticalStackLayout>
        </HorizontalStackLayout>
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Label TextColor="{Binding ScoreColor}"
                   FontSize="20"
                   Margin="2"
                   FontAttributes="Bold">
                <Label.Text>
                    <MultiBinding StringFormat="Score: {0}  Engine: {1}">
                        <Binding Path="Score" />
                        <Binding Path="Engine.State" />
                    </MultiBinding>
                </Label.Text>
            </Label>
            <ListView
                Grid.Row="1"
                Margin="2"
                MinimumHeightRequest="100"
                BackgroundColor="LightBlue"
                HorizontalScrollBarVisibility="Default"
                ItemsSource="{Binding  EngineSuggestedMovements}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Label Margin="1"
                                   LineBreakMode="WordWrap"
                                   MaxLines="5"
                                   TextColor="Black"
                                   FontSize="18">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Score: " TextColor="Black" />
                                        <Span Text="{Binding Score}" TextColor="Black" FontAttributes="Bold" />
                                        <Span Text=" Depth: " TextColor="Black" />
                                        <Span Text="{Binding Depth}" TextColor="Black" FontAttributes="Bold" />
                                        <Span Text="{Binding Path=Movements, StringFormat='  {0}' }"
                                              FontAttributes="Italic" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>


</ContentPage>