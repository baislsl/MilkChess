<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:userInterface="clr-namespace:MilkChess.UserInterface"
             x:DataType="userInterface:ChessBoardViewModel"
             x:Class="MilkChess.MainPage">

    <HorizontalStackLayout
        BackgroundColor="YellowGreen"
        Margin="20">
        <VerticalStackLayout>
            <Label Text="Score: 123"
                   HeightRequest="30" />
            <ListView
                WidthRequest="200"
                RowHeight="20"
                Margin="4"
                BackgroundColor="LightBlue"
                ItemsSource="{Binding HistoryMovement}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell
                            Height="20">
                            <Label HeightRequest="20"
                                   TextColor="Black"
                                   FontSize="18"
                                   FontAttributes="Bold">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0}. {1}">
                                        <Binding Path="ActionCount" />
                                        <Binding Path="ChineseViewableString" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>

                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </VerticalStackLayout>
        <AbsoluteLayout
            WidthRequest="{Binding ChessBoardWidth}"
            HeightRequest="{Binding ChessBoardHeight}"
            x:Name="ChessBoardLayout">
        </AbsoluteLayout>
        <Grid
            Margin="10"
            WidthRequest="300"
            HeightRequest="200"
            BackgroundColor="LightBlue"
            x:Name="CommonFunction">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Reset" Command="{Binding ResetCommand}" />

            <Button Grid.Row="1" Grid.Column="0" Text="Go back" Command="{Binding MoveBackwardCommand}" />
            <Button Grid.Row="1" Grid.Column="1" Text="Move forward" Command="{Binding MoveForwardCommand}" />

            <Button Grid.Row="2" Grid.Column="0" Text="To Start" Command="{Binding MoveToStartCommand}" />
            <Button Grid.Row="2" Grid.Column="1" Text="To End" Command="{Binding  MoveToEndCommand}" />
        </Grid>
        <ListView
            WidthRequest="200"
            RowHeight="20"
            Margin="4"
            BackgroundColor="LightBlue"
            ItemsSource="{Binding HistoryMovement}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell
                        Height="20">
                        <Label HeightRequest="20"
                               TextColor="Black"
                               FontSize="18"
                               FontAttributes="Bold">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0}. {1}">
                                    <Binding Path="ActionCount" />
                                    <Binding Path="ChineseViewableString" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>

                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </HorizontalStackLayout>
</ContentPage>