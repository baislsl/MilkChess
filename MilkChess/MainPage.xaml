<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:userInterface="clr-namespace:MilkChess.UserInterface"
             xmlns:model="clr-namespace:MilkChess.Model"
             xmlns:helper="clr-namespace:MilkChess.Helper"
             x:DataType="userInterface:ChessBoardViewModel"
             x:Name="ChessBoardPage"
             x:Class="MilkChess.MainPage">
    <ContentPage.Resources>
        <helper:MaxDoubleConverter x:Key="MaxDoubleConverter" />
    </ContentPage.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,Auto,Auto"
              RowDefinitions="Auto">
            <ContentView
                Grid.Column="0"
                VerticalOptions="Start"
                IsClippedToBounds="True">
                <AbsoluteLayout
                    AnchorX="0"
                    AnchorY="0"
                    WidthRequest="{Binding GlobalConfig.ChessBoardVisualWidth}"
                    HeightRequest="{Binding GlobalConfig.ChessBoardVisualHeight}"
                    Scale="{Binding GlobalConfig.ChessBoardScale}"
                    x:Name="ChessBoardLayout">
                    <Image
                        ZIndex="{x:Static userInterface:UIConstants.BackgroundZIndex}"
                        Source="{Binding Source={x:Static userInterface:UIConstants.ChessBoardBackgroundResource}}"
                        AbsoluteLayout.LayoutFlags="PositionProportional"
                        AbsoluteLayout.LayoutBounds="0,0,AutoSize,AutoSize" />
                    <BoxView
                        ZIndex="{x:Static userInterface:UIConstants.ExecutionTurnZIndex}"
                        WidthRequest="20"
                        HeightRequest="20"
                        CornerRadius="10"
                        Color="{Binding HistoryManager.ExecutionTurnColor}"
                        AbsoluteLayout.LayoutFlags="None"
                        AbsoluteLayout.LayoutBounds="{Binding ExecutionTurnLayoutBound}" />
                    <Image
                        ZIndex="{x:Static userInterface:UIConstants.CursorSelectorZIndex}"
                        Source="{x:Static userInterface:UIConstants.CursorBackgroundResource}"
                        IsVisible="{Binding CursorSelector.IsVisible}"
                        AbsoluteLayout.LayoutFlags="None"
                        AbsoluteLayout.LayoutBounds="{Binding CursorSelector.LayoutBound}" />
                    <Image
                        ZIndex="{x:Static userInterface:UIConstants.LastMoveIndicatorZIndex}"
                        Source="{x:Static userInterface:UIConstants.LastMoveResource}"
                        IsVisible="{Binding LastMoveIndicator.IsVisible}"
                        AbsoluteLayout.LayoutFlags="None"
                        AbsoluteLayout.LayoutBounds="{Binding LastMoveIndicator.LayoutBound}" />
                    <Image
                        ZIndex="{x:Static userInterface:UIConstants.MovementIndicatorZIndex}"
                        Source="{Binding MovementIndicator.UISource}"
                        IsVisible="{Binding MovementIndicator.From.IsVisible}"
                        AbsoluteLayout.LayoutFlags="None"
                        AbsoluteLayout.LayoutBounds="{Binding MovementIndicator.From.LayoutBound}" />
                    <Image
                        ZIndex="{x:Static userInterface:UIConstants.MovementIndicatorZIndex}"
                        Source="{Binding MovementIndicator.UISource}"
                        IsVisible="{Binding MovementIndicator.To.IsVisible}"
                        AbsoluteLayout.LayoutFlags="None"
                        AbsoluteLayout.LayoutBounds="{Binding MovementIndicator.To.LayoutBound}" />
                </AbsoluteLayout>
            </ContentView>
            <!-- Function button -->
            <Border
                Grid.Column="1"
                Margin="6"
                x:Name="CommonFunction">
                <Grid
                    RowSpacing="2"
                    ColumnSpacing="2"
                    WidthRequest="300">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" /> <!-- spacer -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" /> <!-- spacer -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Row="0" Grid.Column="0"
                            Text="Edit"
                            Command="{Binding EditCommand}" />
                    <Button Grid.Row="0" Grid.Column="1"
                            Text="Reset"
                            Command="{Binding ResetCommand}" />

                    <Button Grid.Row="1" Grid.Column="0"
                            Text="Go Back"
                            Command="{Binding MoveBackwardCommand}" />
                    <Button Grid.Row="1" Grid.Column="1"
                            Text="Go Forward"
                            Command="{Binding MoveForwardCommand}" />

                    <Button Grid.Row="2" Grid.Column="0"
                            Text="To Start"
                            Command="{Binding MoveToStartCommand}" />
                    <Button Grid.Row="2" Grid.Column="1"
                            Text="To End"
                            Command="{Binding  MoveToEndCommand}" />

                    <BoxView
                        Grid.Column="0"
                        Grid.Row="3"
                        Grid.ColumnSpan="2"
                        HeightRequest="1"
                        Margin="4,6" />

                    <Button Grid.Row="4" Grid.Column="0"
                            Text="{Binding ConnectOrDisconnectEngineText}"
                            Command="{Binding ConnectOrDisconnectEngineCommand}" />
                    <Button Grid.Row="4" Grid.Column="1"
                            Text="EditEngine"
                            Command="{Binding ConfigureEngineCommand}" />
                    <Button Grid.Row="5" Grid.Column="0"
                            Text="StopEngine"
                            Command="{Binding StopEngineCommand }" />
                    <Button Grid.Row="5" Grid.Column="1"
                            Text="InvokeImmediate"
                            Command="{Binding InvokeBestMovementCommand}" />

                    <Button Grid.Row="6" Grid.Column="0"
                            BackgroundColor="{Binding SwitchToAnalyzeModeColor}"
                            Text="AnalyzeMode"
                            Command="{Binding SwitchToAnalyzeModeCommand }" />
                    <Button Grid.Row="6" Grid.Column="1"
                            BackgroundColor="{Binding SwitchToAutoModeColor}"
                            Text="AutoMode"
                            Command="{Binding SwitchToAutoModeCommand }" />
                    <Button Grid.Row="7" Grid.Column="0"
                            BackgroundColor="{Binding SwitchToRedAutoModeColor}"
                            Text="RedAutoMode"
                            Command="{Binding SwitchToRedAutoModeCommand}" />
                    <Button Grid.Row="7" Grid.Column="1"
                            BackgroundColor="{Binding SwitchToBlackAutoModeColor}"
                            Text="BlackAutoMode"
                            Command="{Binding SwitchToBlackAutoModeCommand}" />

                    <BoxView
                        Grid.Row="8"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HeightRequest="1"
                        Margin="4,6" />

                    <Button Grid.Row="9" Grid.Column="0"
                            Text="RotateBoard"
                            Command="{Binding RotateBoardCommand}" />

                    <Button Grid.Row="9" Grid.Column="1"
                            Text="ExchangeTurn"
                            Command="{Binding ExchangeTurnCommand}" />

                    <Button Grid.Row="10" Grid.Column="0"
                            Text="SaveLayout"
                            Command="{Binding SaveChessManualCommand}" />

                    <Button Grid.Row="10" Grid.Column="1"
                            Text="CopyFen"
                            Command="{Binding CopyFenCommand}" />

                    <Slider
                        Grid.Row="11"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Minimum="0.5"
                        Maximum="2.0"
                        Value="{Binding GlobalConfig.ChessBoardScale}">
                    </Slider>
                </Grid>
            </Border>
            <Border
                Grid.Column="2"
                VerticalOptions="Fill"
                Margin="6"
                WidthRequest="220"
                x:Name="HistoryMovements">
                <Border.MaximumHeightRequest>
                    <MultiBinding Converter="{StaticResource MaxDoubleConverter}">
                        <Binding Source="{x:Reference ChessBoardLayout}" Path="Height" />
                        <Binding Source="{x:Reference CommonFunction}" Path="Height" />
                    </MultiBinding>
                </Border.MaximumHeightRequest>
                <Grid
                    WidthRequest="200">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Label
                        Grid.Row="0"
                        Text="History Movement"
                        FontAttributes="Bold"
                        Margin="2"
                        FontSize="18" />
                    <CollectionView
                        Grid.Row="1"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        ItemsSource="{Binding HistoryManager.Movements}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    WidthRequest="190"
                                    HeightRequest="28"
                                    Margin="2"
                                    Stroke="#DDDDDD"
                                    StrokeThickness="1"
                                    Padding="6,0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            NumberOfTapsRequired="2"
                                            Command="{Binding Source={x:Reference ChessBoardPage}, Path=ChessBoardViewModel.SwitchToSelectedMovementCommand}"
                                            CommandParameter="{Binding}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        x:Name="MovementLabel"
                                        VerticalTextAlignment="Center"
                                        HorizontalTextAlignment="Start"
                                        FontSize="18"
                                        TextColor="Black">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsSelected}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="FontAttributes" Value="Bold" />
                                                <Setter Property="TextColor" Value="#2176FF" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0}. {1}">
                                                <Binding Path="ActionCount" />
                                                <Binding Path="ChineseViewableString" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
        <Label
            Grid.Row="1"
            FontSize="18"
            FontAttributes="Bold"
            Padding="20, 6, 10, 0"
            TextColor="{Binding EngineFeedback.ScoreColor}">
            <Label.Text>
                <MultiBinding StringFormat="Score: {0},  Engine: {1}, MultiPV: {2}, State: {3}">
                    <Binding Path="EngineFeedback.ScoreText" />
                    <Binding Path="Engine.Name" />
                    <Binding Path="Engine.MultiPv" />
                    <Binding Path="Engine.State" />
                </MultiBinding>
            </Label.Text>
        </Label>
        <Border
            Grid.Row="2"
            Margin="4"
            x:Name="EngineFeedback">
            <CollectionView
                x:Name="PredictMovementTraceList"
                MinimumHeightRequest="100"
                HorizontalScrollBarVisibility="Default"
                ItemsUpdatingScrollMode="KeepScrollOffset"
                ItemsSource="{Binding EngineFeedback.PredictMovementTraces}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:PredictMovementTrace">
                        <Frame
                            Margin="2"
                            Padding="6,4"
                            HasShadow="False"
                            BorderColor="#DDDDDD"
                            BackgroundColor="Transparent"
                            CornerRadius="6">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    NumberOfTapsRequired="1"
                                    Command="{Binding Source={x:Reference ChessBoardLayout}, Path=BindingContext.EngineFeedback.SelectionChangedTaskCommand}"
                                    CommandParameter="{Binding}" />
                            </Frame.GestureRecognizers>
                            <Label
                                FontFamily="Monospace"
                                FontSize="18"
                                LineBreakMode="WordWrap"
                                MaxLines="5">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsSelected}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="FontAttributes" Value="Bold" />
                                        <Setter Property="TextColor" Value="#2176FF" />
                                    </DataTrigger>
                                </Label.Triggers>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Score: " />
                                        <Span Text="{Binding Score}" />
                                        <Span Text=" Depth: " />
                                        <Span Text="{Binding Depth}" />
                                        <Span Text="{Binding MultiPvText}" />
                                        <Span Text="{Binding Movements, StringFormat='  {0}'}"
                                              FontAttributes="Italic" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>