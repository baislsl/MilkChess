<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:userInterface="clr-namespace:MilkChess.UserInterface"
             x:DataType="userInterface:ChessBoardViewModel"
             x:Class="MilkChess.MainPage">

    <HorizontalStackLayout
        Margin="20">
        <AbsoluteLayout
            WidthRequest="{Binding ChessBoardWidth}"
            HeightRequest="{Binding ChessBoardHeight}"
            x:Name="ChessBoardLayout">
        </AbsoluteLayout>

        <StackLayout
            Margin="10">
            <Grid
                Margin="4"
                WidthRequest="300"
                HeightRequest="200"
                x:Name="CommonFunction">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Text="Reset" Clicked="ResetCommand"></Button>
                <Button Grid.Row="0" Grid.Column="1" Text="Reset01"></Button>
                <Button Grid.Row="0" Grid.Column="2" Text="Reset02"></Button>
                <Button Grid.Row="1" Grid.Column="0" Text="Reset10"></Button>
                <Button Grid.Row="1" Grid.Column="1" Text="Reset11"></Button>


            </Grid>
        </StackLayout>
    </HorizontalStackLayout>
</ContentPage>