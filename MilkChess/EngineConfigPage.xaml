<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:milkChess="clr-namespace:MilkChess"
    xmlns:userInterface="clr-namespace:MilkChess.UserInterface"
    xmlns:model="clr-namespace:MilkChess.Model"
    xmlns:helper="clr-namespace:MilkChess.Helper"
    x:DataType="userInterface:EngineConfigViewModel"
    x:Name="EngineConfig"
    x:Class="MilkChess.EngineConfigPage"
    Title="Engine Settings">
    <ContentPage.Resources>
        <ResourceDictionary>
            <helper:StringListToStringConverter x:Key="ArgsConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid ColumnDefinitions="250,*"
          RowDefinitions="Auto,*,Auto"
          Padding="15"
          ColumnSpacing="15"
          RowSpacing="10">

        <!-- 标题 -->
        <Label Text="Engine Configuration"
               FontSize="20"
               FontAttributes="Bold"
               Grid.ColumnSpan="2" />

        <!-- 左侧：引擎列表 -->
        <VerticalStackLayout Grid.Row="1"
                             Grid.Column="0"
                             Spacing="10">
            <CollectionView ItemsSource="{Binding MilkChessConfig.Engines}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedEngine}"
                            HeightRequest="400">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="helper:EngineConfig">
                        <Frame Padding="8"
                               BorderColor="LightGray">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold" />

                                <!-- 默认标识 -->
                                <Label Text="(Default)"
                                       TextColor="Green"
                                       FontSize="12"
                                       IsVisible="{Binding IsDefault}" />
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Add Engine"
                    Command="{Binding AddEngineCommand}" />
            <Button Text="Delete Selected"
                    Command="{Binding RemoveEngineCommand}"
                    CommandParameter="{Binding SelectedEngine}" />
        </VerticalStackLayout>

        <!-- 右侧：编辑区 -->
        <ScrollView Grid.Row="1"
                    Grid.Column="1">
            <VerticalStackLayout Spacing="12">
                <Label Text="Engine Details"
                       FontSize="16"
                       FontAttributes="Bold" />
                <VerticalStackLayout>
                    <Label Text="Name" />
                    <Entry Placeholder="Name"
                           Text="{Binding SelectedEngine.Name}" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="Executable Path" />
                    <VerticalStackLayout>
                        <Entry Placeholder="Execuftable Absolute Path"
                               Text="{Binding SelectedEngine.Path}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="Arguments" />
                    <Entry
                        Placeholder="Arguments"
                        Text="{Binding SelectedEngine.Arguments,
                        Converter={StaticResource ArgsConverter},
                        Mode=TwoWay}" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="Log File" />
                    <Entry Placeholder="Log File"
                           Text="{Binding SelectedEngine.Log}" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="AutoMode Search Depth" />
                    <Entry Text="{Binding SelectedEngine.GoDepth}"
                           Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="Threads" />
                    <Entry Text="{Binding SelectedEngine.Threads}"
                           Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="Connection Timeout (seconds)" />
                    <Entry Text="{Binding SelectedEngine.ConnectionTimeoutSeconds}"
                           Keyboard="Numeric" />
                </VerticalStackLayout>
                <Button Text="Set As Default"
                        Command="{Binding SetAsDefaultCommand}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- 底部按钮区 -->
        <HorizontalStackLayout Grid.Row="2"
                               Grid.ColumnSpan="2"
                               HorizontalOptions="End"
                               Spacing="10">

            <Button Text="Save"
                    Command="{Binding CloseCommand}" />

        </HorizontalStackLayout>

    </Grid>

</ContentPage>