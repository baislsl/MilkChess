<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:milkChess="clr-namespace:MilkChess"
    xmlns:userInterface="clr-namespace:MilkChess.UserInterface"
    xmlns:model="clr-namespace:MilkChess.Model"
    xmlns:helper="clr-namespace:MilkChess.Helper"
    x:DataType="userInterface:EngineConfigViewModel"
    x:Name="EngineConfig"
    x:Class="MilkChess.EngineConfigPage"
    Title="Engine Settings">
    <ContentPage.Resources>
        <ResourceDictionary>
            <helper:StringListToStringConverter x:Key="ArgsConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid ColumnDefinitions="250,*"
          RowDefinitions="Auto,*,Auto"
          Padding="15"
          ColumnSpacing="15"
          RowSpacing="10">

        <!-- 标题 -->
        <Label Text="Engine Configuration"
               FontSize="20"
               FontAttributes="Bold"
               Grid.ColumnSpan="2" />

        <!-- 左侧：引擎列表 -->
        <VerticalStackLayout Grid.Row="1"
                             Grid.Column="0"
                             Spacing="10">
            <CollectionView ItemsSource="{Binding MilkChessConfig.Engines}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedEngine}"
                            HeightRequest="400">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="helper:EngineConfig">
                        <Frame x:Name="RootFrame"
                               Padding="10"
                               CornerRadius="8"
                               BorderColor="#DDDDDD"
                               BackgroundColor="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor"
                                                    Value="Transparent" />
                                            <Setter Property="BorderColor"
                                                    Value="#DDDDDD" />
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor"
                                                    Value="#E8F0FE" />
                                            <Setter Property="BorderColor"
                                                    Value="#4F7DF3" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="14" />
                                <Label Text="Default"
                                       FontSize="11"
                                       Padding="4,1"
                                       BackgroundColor="#DFF5E1"
                                       TextColor="#2E7D32"
                                       IsVisible="{Binding IsDefault}" />
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Add Engine"
                    Command="{Binding AddEngineCommand}" />
            <Button Text="Delete Selected"
                    Command="{Binding RemoveEngineCommand}"
                    CommandParameter="{Binding SelectedEngine}" />
        </VerticalStackLayout>

        <!-- 右侧：编辑区 -->
        <ScrollView Grid.Row="1"
                    Grid.Column="1">
            <Frame Padding="18"
                   CornerRadius="12"
                   BorderColor="#DDDDDD"
                   BackgroundColor="#FAFAFA">
                <VerticalStackLayout Spacing="18">
                    <Grid ColumnDefinitions="*,Auto"
                          VerticalOptions="Center">
                        <!-- 左侧标题 -->
                        <Label Text="Engine Details"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#333333"
                               VerticalOptions="Center" />
                        <!-- 右侧按钮 -->
                        <Button Grid.Column="1"
                                Text="Set As Default"
                                FontSize="13"
                                Padding="10,6"
                                CornerRadius="8"
                                BackgroundColor="#4F7DF3"
                                TextColor="White"
                                Command="{Binding SetAsDefaultCommand}"
                                VerticalOptions="Center" />
                    </Grid>
                    <!-- ========== Basic ========== -->
                    <Label Text="Basic"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#555555" />
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Name"
                                   FontSize="12"
                                   TextColor="#777777" />
                            <Entry Text="{Binding SelectedEngine.Name}"
                                   HeightRequest="36" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Executable Path"
                                   FontSize="12"
                                   TextColor="#777777" />
                            <Entry Text="{Binding SelectedEngine.Path}"
                                   HeightRequest="36" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <!-- 分割线 -->
                    <BoxView HeightRequest="1"
                             BackgroundColor="#E0E0E0" />
                    <!-- ========== Runtime ========== -->
                    <Label Text="Runtime"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#555555" />
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Arguments"
                                   FontSize="12"
                                   TextColor="#777777" />
                            <Entry
                                Text="{Binding SelectedEngine.Arguments,
                                  Converter={StaticResource ArgsConverter},
                                  Mode=TwoWay}"
                                HeightRequest="36" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Threads"
                                   FontSize="12"
                                   TextColor="#777777" />
                            <Entry Text="{Binding SelectedEngine.Threads}"
                                   Keyboard="Numeric"
                                   HeightRequest="36" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <!-- 分割线 -->
                    <BoxView HeightRequest="1"
                             BackgroundColor="#E0E0E0" />

                    <!-- ========== Advanced ========== -->
                    <Label Text="Advanced"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#555555" />
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Search Depth"
                                   FontSize="12"
                                   TextColor="#777777" />
                            <Entry Text="{Binding SelectedEngine.GoDepth}"
                                   Keyboard="Numeric"
                                   HeightRequest="36" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Connection Timeout (seconds)"
                                   FontSize="12"
                                   TextColor="#777777" />
                            <Entry Text="{Binding SelectedEngine.ConnectionTimeoutSeconds}"
                                   Keyboard="Numeric"
                                   HeightRequest="36" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Log File"
                                   FontSize="12"
                                   TextColor="#777777" />
                            <Entry Text="{Binding SelectedEngine.Log}"
                                   HeightRequest="36" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </ScrollView>
        <!-- 底部按钮区 -->
        <HorizontalStackLayout Grid.Row="2"
                               Grid.ColumnSpan="2"
                               HorizontalOptions="End"
                               Spacing="10">
            <Button Text="Save"
                    Command="{Binding CloseCommand}" />

        </HorizontalStackLayout>

    </Grid>

</ContentPage>